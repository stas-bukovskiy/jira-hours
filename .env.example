APP_NAME="Jira Hours"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# php artisan serve handles one request at a time unless this is set.
PHP_CLI_SERVER_WORKERS=4

JIRA_BASE_URL=https://jira.example.com
JIRA_TOKEN=your-personal-access-token
JIRA_TIMEZONE=Europe/Kyiv
# true or false
JIRA_VERIFY_TLS=true
